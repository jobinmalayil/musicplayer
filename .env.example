# Server-side only — never exposed to the browser (no VITE_ prefix).
# See README.md "Google Cloud setup" for step-by-step instructions on
# creating a service account and sharing your Drive folder with it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# The Drive folder this app is scoped to (from its share URL:
# drive.google.com/drive/folders/THIS_PART). Must be shared with the
# service account's email above.
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-folder-id

# Seeds the very first admin account (only used until any users exist in
# the KV store below — after that, manage users from the Admin tab).
APP_USERNAME=your-username
APP_PASSWORD=your-password

# Signs the session cookie so it can't be forged. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=a-long-random-string

# Upstash Redis — stores the admin-managed user list. Create a free database
# via Vercel's Storage tab (Marketplace Database Providers → Upstash for
# Redis) and connect it to this project; these two are added automatically.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-upstash-token

# Sent to the browser (VITE_ prefix required) — used only to ask a signed-in
# admin's own Google account for permission to upload new songs. Reuses the
# same OAuth Web application client from Google Cloud Console you may have
# set up earlier; if you don't have one, create one there (Authorized
# JavaScript origins: your dev URL and your deployed URL, no redirect URI
# needed) and make sure your Google account is added as a test user on the
# OAuth consent screen.
VITE_GOOGLE_UPLOAD_CLIENT_ID=your-client-id.apps.googleusercontent.com
